  "draft": false,
  "source": {
    "version": 1,
    "profile": {
      "name": "PhotonFusionFPSTest",
      "tileSize": 15,
      "playerRadius": 0.35,
      "playerHeight": 1.8,
      "navigationRadius": 0.35,
      "navigationHeight": 2.25,
      "maxStep": 0.5,
      "maxSlope": 45,
      "doorWidth": 1.2,
      "doorHeight": 2.5,
      "stairWidth": 1.4,
      "floorClearance": 2.6,
      "passableWindowWidth": 3,
      "passableWindowHeight": 1.6,
      "passableWindowSill": 1
    },
    "request": {
      "width": 4,
      "depth": 3,
      "north": "Any",
      "east": "Any",
      "south": "RequiresRoad",
      "west": "RequiresRoad",
      "category": "Complex",
      "description": "A 6 story main hospital of the city. Inspired heavily from \u0022no mercy\u0022 in L4D. Should be white/beige colored with green crosses on it. Should be \u0022modern\u0022 and consist of many block shapes from the outside. Should have the hospital logo on its sides so it is easily recognizable from far away. The main entrance should have a driveway for ambulances to quickly access the building. The driveway should go from side to side, allowing an ambulance to drive \u0022along\u0022 the road to access the main door, and continue going forward to join back to the road it was on originally after dropping the patient off. On the \u0022backside\u0022 there should be back entrances.\r\n\r\nThe first floor should have a large reception area with waiting benches. There should also be toilets to this room directly. There could also be a elevator connecting all floors, it should obviously be broken and the elevator could be on the bottom floor, accessible and static. From the other floors if the elevator doors are open, you could jump down. On the first floor there also is a break room, storage, etc...\r\n\r\nOn the other floors there are the facilities you would expect from a hospital. Patient rooms, toilets, office/break rooms for nurses, etc...\r\n\r\nAt the final floor of the hospital there should be a \u0022special\u0022 surgery room with a storage room. We will place some special health loot here, so it should be identifiable as a \u0022special\u0022 room. \r\n\r\nAt the roof of the hospital there should be a helipad with a helicopter. It can be visibly broken down or not, does not matter. If possible, make the roof accessible. If it is, there should be a raised helipad on the roof, some fencing preventing people from falling down, AC output units, stuff you would imagine finding from a roof of a hospital.\r\n\r\nPlease also make a 7th floor that takes up approx. half of the footprint of the building. From this raised part, there can just be a door to the roof. This raised parts roof does not need to be accessible. This also \u0022breaks\u0022 up the silhouette of the building nicely. The helipad, other roof goodies should be on the lower part.\r\n\r\nThe rooms should be put down in a way that makes sense. Think of how a hospital works and what needs to be connected to what.  From the outside the building should be easily recognizable as a hospital. The building should not just be a solid block, but rather should have a more interesting shape from the outside. Add dumpsters, benches, trees, some trash, maybe an ambulance? etc... on the outside on the front/back where it makes sense.",
      "condition": "Vandalized",
      "materialStyle": "City",
      "furnitureDensity": 2
    },
    "plan": {
      "name": "Mercy Central Hospital",
      "kind": "Complex",
      "summary": "Reconfigured all six core stairs into alternating side-by-side flights with matching floor cutouts and clear end landings, connecting every storey and the existing helipad access.",
      "blockerHeight": 0,
      "blockerMaterial": "dark",
